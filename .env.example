# Yorùbá Heritage World Virtual — environment configuration
#
# Copy this file to .env and fill in real values.
# .env is ignored by Git and must NEVER be committed.
# This file contains PLACEHOLDERS ONLY — no real credentials.

# --- Application ---
NODE_ENV=development
APP_PORT=3000

# --- Database (MySQL / MariaDB) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=yoruba_heritage_world

# Root password is used only by the local Docker Compose MariaDB container.
DATABASE_ROOT_PASSWORD=your_root_password

# --- Reserved for later approved phases (leave unset until implemented) ---
# SESSION_SECRET=
# KLING_API_KEY=
# OPENART_API_KEY=
# TTS_API_KEY=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
