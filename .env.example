# Yorùbá Heritage World Virtual — environment configuration
#
# Copy this file to .env and fill in real values.
# .env is ignored by Git and must NEVER be committed.
# This file contains PLACEHOLDERS ONLY — no real credentials.

# --- Application ---
NODE_ENV=development
APP_PORT=3000

# Set to true ONLY when running behind a trusted reverse proxy that
# overwrites X-Forwarded-For (e.g. the VPS proxy). When false (default),
# client IPs come from the socket and the header is ignored so it
# cannot be spoofed to evade login rate limiting.
TRUST_PROXY=false

# --- Database (MySQL / MariaDB) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=yoruba_heritage_world

# Root password is used only by the local Docker Compose MariaDB container.
DATABASE_ROOT_PASSWORD=your_root_password

# --- Application origin (used for payment callback/return URLs) ---
# Production MUST use the platform HTTPS origin. Never accepted from
# browser parameters.
APP_BASE_URL=http://localhost:3000

# --- Payments (Step 6) ---
# Global safe switch. A fresh deployment must never accidentally start
# accepting money: EVERYTHING defaults to disabled.
PAYMENTS_ENABLED=false

# Currency lists are configuration DEFAULTS/placeholders only — they are
# NOT claims about what any real merchant account supports. Operators
# must set them according to their actual provider/merchant accounts.

PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=NGN,USD

PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCIES=USD,GBP,EUR

STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=USD,GBP,EUR

# Crypto stays mock-only until a concrete processor is explicitly
# approved. CRYPTO_PROVIDER=mock is INVALID in production while
# CRYPTO_ENABLED=true (startup fails safe).
CRYPTO_ENABLED=false
CRYPTO_PROVIDER=mock
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_FIAT_CURRENCIES=USD

# --- Runtime drivers (Step 20) ---
#
# Every driver below is an EXPLICIT ENUM. An unknown or misspelt value
# stops the process at startup in EVERY environment — there is no silent
# fall back to the local/mock adapter, because "it quietly used the
# mock" is the production failure these settings exist to prevent.

# Local working storage for approved and intermediate media (NOT the
# final recording). Shared by the app and the worker.
MEDIA_STORAGE_DIR=

# --- Final PRIVATE object storage ---
# LOCAL is a directory on one machine: correct for development, and
# REFUSED in production. S3 = any S3-compatible PRIVATE bucket.
# The bucket must have NO public access, NO website configuration and NO
# CDN in front of it. The application never sets an ACL and never builds
# a public URL; the only way bytes leave is a signed GET of at most 15
# minutes.
OBJECT_STORAGE_DRIVER=LOCAL
OBJECT_STORAGE_ROOT=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Most non-AWS S3-compatible services need path-style addressing.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- Render ---
# MOCK produces a synthetic artifact that is NOT a deliverable video —
# development and test only, and refused in production. REMOTION is the
# real compositor; it needs ffprobe available and provisions a headless
# browser on first use (see docs/OPERATIONS.md).
RENDER_DRIVER=MOCK
# Absolute path to ffprobe; empty resolves it from PATH.
FFPROBE_PATH=
REMOTION_CONCURRENCY=1
REMOTION_TIMEOUT_MS=600000

# --- Visual generation and speech synthesis ---
#
# VISUAL generation has ONE approved production adapter: KLING —
# Kling API 2.0 text-to-video (Kling 3.0 encoded in the endpoint),
# VISUALS ONLY (native audio always requested off). MOCK and DISABLED
# behave as below. Selecting KLING requires ALL of the KLING_*
# variables, in every environment.
#
#   MOCK      deterministic synthetic output — development and test
#             only, refused in production;
#   DISABLED  no backend. A job that REQUIRES the work FAILS CLOSED and
#             is recorded as failed; it is never silently skipped. A
#             manifest that needs neither (approved media for every
#             scene, approved human recordings for every voice) runs
#             normally.
VISUAL_GENERATION_DRIVER=MOCK

# --- Kling visual generation (required when VISUAL_GENERATION_DRIVER=KLING) ---
# The API key is a SECRET: server environment only — never committed,
# never logged, never persisted anywhere else.
KLING_API_KEY=
# Plain HTTPS base URL of the Kling API 2.0 host — no credentials, no
# query, no fragment. Official example: https://api-singapore.klingai.com
KLING_API_BASE_URL=
# Comma-separated allowlist of BARE HTTPS ORIGINS that completed
# artifacts may be downloaded from — exact origins only (no paths, no
# wildcards). A video URL on any other origin is refused, never fetched.
KLING_ARTIFACT_ORIGINS=

# SPEECH synthesis has ONE approved production adapter: 9JALINGO —
# 9jaLingo's OpenAI-compatible synchronous /v1/audio/speech, Yoruba
# (yo) ONLY. MOCK and DISABLED behave exactly as above. Selecting
# 9JALINGO requires ALL of the NAIJALINGO_* variables below, in every
# environment; approved human recordings remain preferred and are
# never synthesized.
TTS_DRIVER=MOCK

# Notification email channel (Step 23). MOCK records messages in
# memory and makes no network call; DISABLED is the honest setting
# until an email vendor is approved. MOCK is refused in production.
NOTIFICATION_EMAIL_DRIVER=MOCK

# --- 9jaLingo TTS (required when TTS_DRIVER=9JALINGO) ---
# The API key is a SECRET: server environment only — never committed,
# never logged, never persisted anywhere else.
NAIJALINGO_API_KEY=
# Plain HTTPS base URL of the OpenAI-compatible endpoint — no
# credentials, no query, no fragment (e.g. https://api.example/v1).
NAIJALINGO_API_BASE_URL=
# The approved Yoruba voices, one per production profile. A Sacred
# House speaks in the voice of its approved representative, so BOTH are
# required and neither ever stands in for the other. The ONLY path to a
# voice choice is these trusted server variables — never a request, a
# row, or any reference audio (the contract has no cloning input).
NAIJALINGO_YO_MALE_VOICE_ID=
NAIJALINGO_YO_FEMALE_VOICE_ID=
# The operator-selected 9jaLingo model id.
NAIJALINGO_MODEL=

# --- Reserved for later approved phases (leave unset until implemented) ---
# Sessions deliberately need NO secret: they are 256-bit random bearer
# tokens stored hashed, so there is no SESSION_SECRET to leak or rotate.
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASSWORD=
