# Yorùbá Heritage World Virtual — SERVER environment template.
#
# Copy to /opt/yhw/.env on the VPS and fill in. This file is a TEMPLATE:
# it contains no secret, no key and no password, and it never should.
# The real file lives only on the server, is never committed, and is
# never copied from a development machine — a laptop's .env carries
# development credentials, a development database name and, in this
# project's case, a real 9jaLingo key that production is not authorised
# to spend.
#
#   chmod 600 /opt/yhw/.env
#
# GENERATE EACH SECRET ON THE SERVER, e.g.:
#   openssl rand -base64 36 | tr -d '/+=' | head -c 40
#
# Every value marked CHANGE_ME must be replaced. Compose refuses to
# start when the `:?` guarded ones are missing, and the application's
# own preflight refuses to bind a port when the rest are wrong.

# --- Identity -----------------------------------------------------------
NODE_ENV=production
APP_REVISION=faa2da8

# The domain people visit. Must resolve to this server BEFORE first
# start: Caddy fetches a certificate on boot and the ACME challenge
# fails otherwise. The www name is redirected to it permanently, and
# needs its own A record for the same reason.
APP_DOMAIN=CHANGE_ME.example
# Must be https:// and must match APP_DOMAIN. Payment return URLs and
# every server-generated link are built from this; the preflight
# refuses a non-HTTPS value in production.
APP_BASE_URL=https://CHANGE_ME.example

# The private object store's public name — a browser is redirected here
# to play a finished recording, and the CSP names this origin as the
# only external media source. Changing it later breaks playback.
STORAGE_DOMAIN=storage.CHANGE_ME.example

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=CHANGE_ME@example.com

# TRUE only because Caddy sits in front and OVERWRITES X-Forwarded-For.
# Without a proxy that overwrites it, any client could forge their IP
# and walk through rate limiting. The preflight requires this to be
# explicitly present — its absence is itself a failure.
TRUST_PROXY=true

# --- Database (MariaDB 11 — NOT PostgreSQL) -----------------------------
# Reachable only on the private Compose network; 3306 is never published.
DATABASE_NAME=yoruba_heritage_world
DATABASE_USER=yhwv
DATABASE_PASSWORD=CHANGE_ME
DATABASE_ROOT_PASSWORD=CHANGE_ME

# --- Private object storage (MinIO, proxied at STORAGE_DOMAIN) ----------
# LOCAL is refused in production: a finished prayer on a container's
# own disk is one `docker compose down -v` away from gone.
OBJECT_STORAGE_DRIVER=S3
OBJECT_STORAGE_ENDPOINT=https://storage.CHANGE_ME.example
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=yhw-recordings
OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
# REQUIRED true. Virtual-hosted addressing puts the bucket in the
# hostname, which would land signed URLs on an origin the Prayer Room's
# pin and the CSP do not know — every playback would be refused.
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# --- Rendering ----------------------------------------------------------
# There is no "off" for rendering: the driver is MOCK or REMOTION, and
# production refuses MOCK. REMOTION costs nothing until a job actually
# reaches the render stage, which cannot happen while no template is
# published.
RENDER_DRIVER=REMOTION
FFPROBE_PATH=/usr/bin/ffprobe
REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
# One at a time. A headless browser compositing frames is the only part
# of this system that can take the whole machine with it.
REMOTION_CONCURRENCY=1
REMOTION_TIMEOUT_MS=600000

# --- External generation: ALL OFF ---------------------------------------
# DISABLED, never MOCK. Production refuses MOCK because handing somebody
# synthetic output as their prayer is not a production option; DISABLED
# means work needing the capability fails closed and is recorded.
# Turning either on is a separate, gated decision.
VISUAL_GENERATION_DRIVER=DISABLED
TTS_DRIVER=DISABLED
NOTIFICATION_EMAIL_DRIVER=DISABLED

# 9jaLingo: intentionally BLANK on this server. No live synthesis is
# authorised, and an unspendable deployment cannot spend by accident.
NAIJALINGO_API_KEY=
NAIJALINGO_API_BASE_URL=
NAIJALINGO_YO_MALE_VOICE_ID=
NAIJALINGO_YO_FEMALE_VOICE_ID=
NAIJALINGO_MODEL=

# Kling: likewise blank.
KLING_API_KEY=
KLING_API_BASE_URL=
KLING_ARTIFACT_ORIGINS=

# --- Payments: OFF ------------------------------------------------------
# PAYMENTS_ENABLED is the global kill-switch; each provider also has its
# own. Nothing can charge anybody while this is false.
PAYMENTS_ENABLED=false
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=
PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCIES=
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=
CRYPTO_ENABLED=false
CRYPTO_PROVIDER=mock
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=
CRYPTO_FIAT_CURRENCIES=
