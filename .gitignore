# --- Dependencies ---
node_modules/

# --- Environment / secrets ---
# Never commit real credentials, API keys, or production configuration.
# Only .env.example (placeholders) belongs in Git.
.env
.env.*
# The two TEMPLATES are the exception: they carry placeholders only,
# and a deployment template nobody can read is a deployment nobody can
# reproduce.
!.env.example
!.env.production.example
*.pem
*.key

# --- Build outputs ---
dist/
dist-ssr/
.output/
.nitro/
.tanstack/
.vinxi/
.wrangler/
*.local

# --- Test / coverage ---
coverage/

# --- Logs ---
*.log
logs/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Local database data (if ever mounted locally) ---
db-data/

# --- Private media storage (Step 10) ---
# Uploaded media binaries are NEVER committed.
var/media/

# --- Private object storage (Step 17) ---
# Uploaded render objects are NEVER committed.
var/objects/

# --- Governed Babalawo proof package ---
# Keep the approved private baseline and QA notes reproducible, but do
# not commit raw provider clips, source audio or QA frame grabs.
/BABALAWO_90S/*
!/BABALAWO_90S/final/
/BABALAWO_90S/final/*
!/BABALAWO_90S/final/BABALAWO_PRAYER_ROOM_90S_MASTER_V2.mp4
!/BABALAWO_90S/qa/
/BABALAWO_90S/qa/*
!/BABALAWO_90S/qa/*.md
