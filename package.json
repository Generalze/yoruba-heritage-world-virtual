{
  "name": "yoruba-heritage-world-virtual",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "vite build",
    "start": "bun run server.ts",
    "worker:generation": "bun run src/workers/prayer-generation-worker.ts",
    "preview": "bun --bun vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed:domain": "bun run src/db/seed-domain.ts",
    "admin:grant": "bun run src/db/grant-role.ts",
    "db:studio": "drizzle-kit studio",
    "smoke:runtime": "bun run scripts/runtime-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@remotion/bundler": "4.0.507",
    "@remotion/renderer": "4.0.507",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.23",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.40",
    "drizzle-orm": "^0.44.0",
    "mysql2": "^3.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.507",
    "tailwindcss": "^4.1.18",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
